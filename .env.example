# Live commerce is intentionally disabled until merchant, catalog, tax and shipping review.
COMMERCE_ENABLED=false
STRIPE_SECRET_KEY=

# Admin panel (/admin). Put these in your local .env (git-ignored) and restart `pnpm dev`.
# Use a long, unique password. In production store them as Worker secrets:
#   wrangler secret put ADMIN_EMAIL / ADMIN_PASSWORD
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: separate secret used to sign the admin session cookie (any long random string).
ADMIN_SESSION_SECRET=
